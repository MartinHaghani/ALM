<!--
    This launch file starts all communication needed in order to control and localize the bot.
    I.e. the raw data comms to the Low Level Board, the GPS, etc.
-->
<launch>
    <!-- TODO: Add parameter for simulation -->
    <!-- v1 if HARDWARE_PLATFORM == 1 -->
    <group if="$(eval env('HARDWARE_PLATFORM') == '1')">
        <!-- Comms v1 -->
        <node pkg="mower_comms_v1" type="mower_comms_v1" name="ll" unless="$(optenv OM_NO_COMMS False)"
                output="screen" respawn="true" respawn_delay="10">
        </node>
        <!-- GPS driver only for v1 builds -->
        <node pkg="xbot_driver_gps" type="driver_gps_node" name="gps"
                ns="ll/services"
                output="screen"
                respawn="$(eval optenv('OM_GPS_RESPAWN', 'True').lower() == 'true')"
                respawn_delay="5"
                unless="$(optenv OM_NO_GPS False)">
            <param name="rtcm_topic" value="/ll/position/gps/rtcm"/>
            <param name="nmea_topic" value="/ll/position/gps/nmea"/>
            <param name="xb_pose_topic" value="/ll/position/gps"/>
            <param name="wheel_ticks_topic" value="/mower/wheel_ticks"/>
        </node>

    </group>

    <!-- v2 if HARDWARE_PLATFORM == 2 -->
    <group if="$(eval env('HARDWARE_PLATFORM') == '2')">
        <group unless="$(optenv OM_NO_COMMS False)">
            <!-- Use V2 Comms -->
            <node pkg="mower_comms_v2" type="mower_comms_v2" name="mower_comms_v2" output="screen" respawn="true" respawn_delay="10">
            </node>
        </group>
    </group>
    <group unless="$(optenv OM_NO_GPS False)">
    <!-- Correction input for both: v1 and v2 -->
        <include if="$(eval optenv('OM_USE_NTRIP', 'True').lower() == 'true' and optenv('OM_USE_RTCM_TCP', 'False').lower() != 'true')"
                 file="$(find open_mower)/launch/include/_ntrip_client.launch"/>
        <node if="$(eval optenv('OM_USE_RTCM_TCP', 'False').lower() == 'true')"
              pkg="open_mower"
              type="rtcm_tcp_bridge.py"
              name="rtcm_tcp_bridge"
              output="screen"
              respawn="true"
              respawn_delay="10">
            <param name="host" value="$(optenv OM_RTCM_TCP_HOSTNAME 127.0.0.1)"/>
            <param name="port" value="$(optenv OM_RTCM_TCP_PORT 5016)"/>
            <remap from="rtcm" to="/ll/position/gps/rtcm"/>
        </node>
    </group>

</launch>
