<launch>
    <node pkg="xbot_positioning" type="xbot_positioning" name="xbot_positioning" output="screen" respawn="true" respawn_delay="10">
        <param name="max_gyro_calibration_abs_offset" value="$(optenv OM_XBOT_POSITIONING_MAX_GYRO_CALIBRATION_ABS_OFFSET 0.05)" type="double"/>
        <param name="max_gyro_calibration_stddev" value="$(optenv OM_XBOT_POSITIONING_MAX_GYRO_CALIBRATION_STDDEV 0.01)" type="double"/>
        <param name="max_gyro_calibration_range" value="$(optenv OM_XBOT_POSITIONING_MAX_GYRO_CALIBRATION_RANGE 0.03)" type="double"/>
        <remap from="~imu_in" to="/hw/imu/data_raw"/>
        <remap from="~twist_in" to="/hw/diff_drive/measured_twist"/>
        <remap from="~xb_pose_in" to="/hw/position/gps"/>
        <remap from="~xb_pose_out" to="xbot_positioning/xb_pose"/>
    </node>
</launch>
